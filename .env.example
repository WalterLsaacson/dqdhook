# Copy to repo-root .env and fill in secrets. Never commit .env.
# Values below match the current production knobs (mqtt gate, no rest GTC,
# T+10 delay 480s). Replace PRIVATE_KEY / FUNDER / apifootball_key.

# =============================================================================
# Polymarket CLOB
# =============================================================================

# Export wallet private key (0x + 64 hex). Do not commit.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Polygon mainnet
CHAIN_ID=137

# 0=EOA · 2=POLY_GNOSIS_SAFE · 3=POLY_1271 (Deposit Wallet)
SIGNATURE_TYPE=3

# Profile wallet from polymarket.com (required for SIGNATURE_TYPE=2/3)
FUNDER=0xYOUR_FUNDER_ADDRESS

CLOB_HOST=https://clob.polymarket.com

# =============================================================================
# Quote sizing / buy floor
# =============================================================================

QUOTE_MAX_USDC=2
QUOTE_MAX_SHARES=150
QUOTE_MAX_OPEN_USDC=100000
QUOTE_SIZE_FLOOR_USDC=1

# Pitch-gate FAK
QUOTE_GOAL_MAX_USDC=2
QUOTE_GOAL_MAX_SHARES=150
QUOTE_GOAL_SIZE_TIERS=0.98:50

# Full-time FAK
QUOTE_FT_MAX_USDC=100
QUOTE_FT_MAX_SHARES=2000
QUOTE_FT_SIZE_TIERS=0.98:300

# FT locked WIN with ask ≤0.01. 0 = off
QUOTE_FT_DUST_USDC=0
QUOTE_FT_DUST_FAK=0

# Pitch-gate: if this goal is voided and the token is still WIN, FAK remaining asks
QUOTE_LOCKED_SWEEP=1
QUOTE_LOCKED_SWEEP_USDC=100

# Goal T+10 rescan (delay 8 min): FAK + 0.99 GTC each use this amount
QUOTE_T10_USDC=100
QUOTE_T10_DELAY_S=480

QUOTE_DQD_STREAM_OBSERVE=1
QUOTE_GATE_SOURCE=mqtt
QUOTE_PITCH_STATE=1

# leftover buy_win floor (not used on pitch-gate / T+10 / FT)
QUOTE_MIN_BUY_PRICE=0.6
# pitch-gate / T+10: skip FAK and rest below this; FT dust still skips this floor
QUOTE_GATE_MIN_BUY_PRICE=0.30

# skip match_finished older than this (restart replay guard)
QUOTE_FT_MAX_AGE_S=900

# 0 = do not place 0.99 rest from pitch-gate; T+10 still rests independently
QUOTE_REST_ENABLED=0

# Nami MQTT ball-zone observe (not used for order sizing)
QUOTE_NAMI_OBSERVE=1

# =============================================================================
# Network / bind
# =============================================================================

# Runner always forces PM_PROXY=none. Leave unset or none.
PM_PROXY=none

# Optional. If unset, dqdhook-run.sh uses the first hostname -I address.
# DQD_PUBLIC_HOST=203.0.113.10
# DQD_BIND=0.0.0.0

# =============================================================================
# External API keys
# =============================================================================

# API-Football (api-sports.io). Required for AF observe / referee / T+10 score check.
# Dashboard: https://dashboard.api-football.com/
apifootball_key=YOUR_API_FOOTBALL_KEY

# Odds-API.io — optional observe only. Leave unset if the key is expired.
# ODDS_API_IO_KEY=
